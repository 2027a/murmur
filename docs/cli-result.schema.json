{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.2027a.net/2027a/murmur/schemas/cli-result-v1.json",
  "title": "Murmur composable CLI result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "command",
    "success",
    "provider",
    "model",
    "language",
    "transcript_raw",
    "transcript_final",
    "segment_count",
    "segments",
    "warnings",
    "error"
  ],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "command": { "type": "string", "enum": ["transcribe", "cleanup", "dictate"] },
    "success": { "type": "boolean" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "language": { "type": "string" },
    "transcript_raw": { "type": "string" },
    "transcript_final": { "type": "string" },
    "segment_count": { "type": "integer", "minimum": 0 },
    "segments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "provider", "model", "language", "transcript"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string" },
          "language": { "type": "string" },
          "transcript": { "type": "string", "minLength": 1 },
          "overlap_words": { "type": "integer", "minimum": 2, "maximum": 8 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "provider", "component", "message"],
        "properties": {
          "class": { "$ref": "#/$defs/optionalErrorClass" },
          "provider": { "type": "string" },
          "component": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "success": { "const": true } },
        "required": ["success"]
      },
      "then": {
        "properties": { "error": { "type": "null" } }
      },
      "else": {
        "properties": { "error": { "$ref": "#/$defs/error" } }
      }
    },
    {
      "if": {
        "properties": { "command": { "const": "cleanup" } },
        "required": ["command"]
      },
      "then": {
        "properties": {
          "language": { "const": "" },
          "segment_count": { "const": 0 },
          "segments": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "enum": ["transcribe", "dictate"] },
          "success": { "const": true }
        },
        "required": ["command", "success"]
      },
      "then": {
        "properties": {
          "segment_count": { "minimum": 1 },
          "segments": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "provider": { "const": "mixed" } },
        "required": ["provider"]
      },
      "then": {
        "properties": {
          "model": { "const": "" },
          "language": { "const": "" },
          "segments": { "minItems": 2 }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "component", "message"],
      "properties": {
        "class": { "$ref": "#/$defs/errorClass" },
        "component": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "errorClass": {
      "type": "string",
      "enum": [
        "config_invalid",
        "policy_blocked",
        "audio_failed",
        "unavailable",
        "auth_failed",
        "timeout",
        "empty_response",
        "server_error",
        "no_speech",
        "sink_failed",
        "cancelled",
        "internal"
      ]
    },
    "optionalErrorClass": {
      "type": "string",
      "enum": [
        "",
        "config_invalid",
        "policy_blocked",
        "audio_failed",
        "unavailable",
        "auth_failed",
        "timeout",
        "empty_response",
        "server_error",
        "no_speech",
        "sink_failed",
        "cancelled",
        "internal"
      ]
    }
  }
}
